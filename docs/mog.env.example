# MOG Lifestyle -- production settings.
#
# Copy to  ~/mog-data/mog.env  on the server (NOT inside the app folder, and
# never into git), then:   chmod 600 ~/mog-data/mog.env
# Replace USER with your cPanel username throughout.
# One KEY=value per line.  Everything after the first "=" is the value, so
# passwords may contain "#" or "=".  Don't add comments on the same line.

# -- core ------------------------------------------------------------------
MOG_ENV=production
# 64 random hex characters.  Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it later signs everybody out.
MOG_SECRET_KEY=
MOG_BASE_URL=https://moglifestyle.fit
MOG_DB=/home/USER/mog-data/mog.sqlite3
MOG_FORCE_HTTPS=1
MOG_SECURE_COOKIES=1
MOG_TIMEZONE=America/Boise

# -- first administrator ---------------------------------------------------
# Used once by `python run.py --seed`.  Or leave the password out and run
# `python run.py --create-admin info@moglifestyle.fit` to be prompted instead.
# Delete the password line again afterwards.
MOG_ADMIN_EMAIL=info@moglifestyle.fit
# MOG_ADMIN_PASSWORD=

# -- payments (Stripe dashboard -> Developers) -----------------------------
# Leave empty to run checkout in demo mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -- email -----------------------------------------------------------------
# Namecheap Private Email: mail.privateemail.com, port 587.
# cPanel mailbox: mail.moglifestyle.fit, port 587.
# Leave SMTP_HOST empty and mail is only logged, never sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=info@moglifestyle.fit
SMTP_PASSWORD=
SMTP_STARTTLS=1
MAIL_FROM=MOG Lifestyle <info@moglifestyle.fit>
MOG_STORE_EMAIL=info@moglifestyle.fit

# -- pre-launch countdown (docs/PREORDER.md) -------------------------------
# Until this moment the public sees ONLY the countdown page; the full site
# opens by itself when it passes. Date, 24-hour time and time zone in ONE
# value. Confirmed launch: 20 November 2026, 10:00 AM Mountain Time.
# To open the site now, use a time in the past.
MOG_PREORDER_OPENS_AT=2026-11-20 10:00 America/Boise
# Optional: where visitors land when the countdown ends (default: homepage).
# MOG_PREORDER_URL=/shop?collection=preorder
# demo = Notify Me saves nothing; live = real mailing list. Production
# defaults to live.
# MOG_PREORDER_FORMS=live

# -- social ----------------------------------------------------------------
MOG_INSTAGRAM=mog.lifestyle
